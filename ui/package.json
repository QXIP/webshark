{
  "name": "webshark",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config src/proxy.conf.json --host=0.0.0.0 --port=8003 --allowed-hosts",
    "start:kiosk": "ng serve --proxy-config src/proxy.conf.json --configuration kiosk --host=0.0.0.0 --port=8003 --allowed-hosts",
    "start:static": "ng serve --configuration static --host=0.0.0.0 --port=8003 --allowed-hosts",
    "demo": "ng serve --proxy-config src/proxy.demo.json --host=0.0.0.0 --port=8004 --allowed-hosts",
    "build": "ng build --configuration production",
    "build:kiosk": "ng build --configuration kiosk",
    "build:static": "ng build --configuration static",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch --browsers=ChromeHeadlessCI"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@ffmpeg/ffmpeg": "^0.12.6",
    "@ffmpeg/util": "^0.12.1",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@goodtools/wiregasm": "^1.9.1",
    "angular-split": "^20.0.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "ng-table-virtual-scroll": "^1.6.1",
    "rxjs": "~7.8.0",
    "ts-md5": "^1.3.1",
    "tslib": "^2.3.0",
    "wavesurfer.js": "^7.2.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "~22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@types/jasmine": "~4.3.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}