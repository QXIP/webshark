{
  "name": "webshark-api",
  "version": "2.0.2",
  "description": "webShark/sharkd API backend",
  "main": "app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "tap --no-coverage test/**/*.test.js",
    "test:all": "tap --no-coverage test/**/*.test.js",
    "start": "npx fastify start -l info app.js -a 0.0.0.0 -p 8085",
    "dev": "fastify start -l info -P app.js -a 0.0.0.0 -p 8085"
  },
  "keywords": [
    "webshark"
  ],
  "author": "joviniko@gmail.com",
  "license": "GPLv2",
  "dependencies": {
    "@fastify/autoload": "^5.7.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "async-lock": "^1.2.0",
    "fastify": "^5.12.1",
    "fastify-cli": "^8.0.2",
    "fastify-plugin": "^4.5.1",
    "glob-parent": "^6.0.2",
    "JSONStream": "^1.3.5",
    "node-fetch": "^3.2.6",
    "promise-socket": "^7.0.0",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "tap": "^16.3.8"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "browserslist": "4.28.7",
    "fastify": "$fastify",
    "js-yaml": "3.15.2",
    "lodash": "4.17.23",
    "minimatch@3": "3.1.3",
    "shell-quote": "1.9.0",
    "ws": "7.5.11"
  }
}
